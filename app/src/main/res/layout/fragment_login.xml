<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EAEAEA"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- CONTEÚDO PRINCIPAL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <!-- LOGO TRACKER -->
        <ImageView
            android:layout_width="155dp"
            android:layout_height="60dp"
            android:layout_marginBottom="2dp"
            android:src="@drawable/logo_tracker"
            android:scaleType="fitCenter"
            android:contentDescription="@string/Tracker" />

        <!-- SUBTÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="28dp"
            android:text="@string/textinho"
            android:textColor="#333333"
            android:textSize="11sp" />

        <!-- E-MAIL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/email"
            android:textColor="#914B7E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- CAMPO E-MAIL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="13dp"
            android:background="@drawable/bg_edittext"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="9dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_email"
                android:scaleType="centerInside"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/editEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/text_email"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:paddingStart="7dp"
                android:paddingEnd="4dp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- SENHA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/senha"
            android:textColor="#914B7E"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- CAMPO SENHA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_edittext"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="9dp"
            android:paddingEnd="9dp">

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:src="@drawable/ic_lock"
                android:scaleType="centerInside"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/editSenha"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/text_senha"
                android:inputType="textPassword"
                android:singleLine="true"
                android:paddingStart="7dp"
                android:paddingEnd="4dp"
                android:textColor="#333333"
                android:textColorHint="#999999"
                android:textSize="10sp" />

        </LinearLayout>

        <!-- LEMBRAR-ME -->
        <CheckBox
            android:id="@+id/checkLembrar"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:buttonTint="#C18AAD"
            android:text="@string/lembra"
            android:textColor="#777777"
            android:textSize="10sp"
            android:padding="0dp" />

        <!-- BOTÃO ENTRAR -->
        <Button
            android:id="@+id/buttonLogin"
            android:layout_width="150dp"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_login"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:text="@string/bt_entrar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- DIVISÓRIA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="78dp"
            android:layout_marginBottom="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D0D0D0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/continuee"
                android:textColor="@color/roxo_claro"
                android:textSize="9sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D0D0D0" />

        </LinearLayout>

        <!-- CRIAR CONTA -->
        <Button
            android:id="@+id/buttonCadastro"
            android:layout_width="150dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_cadastro"
            android:text="@string/conta"
            android:textAllCaps="false"
            android:textColor="#333333"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- RODAPÉ -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/Tracker"
        android:textColor="@color/laranja"
        android:textSize="16sp"
        android:gravity="start" />

</LinearLayout>